		<region region-id="23320" left="36" top="6914.25" width="277.5" height="12" align-x="49.5" align-y="6924" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<b>
						<u>Setting of phase selection with load encroachment (PPHS)</u>
					</b>
				</p>
			</text>
		</region>
		<region region-id="23321" left="42" top="6944.25" width="474" height="12" align-x="48" align-y="6954" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Set mengcover melebihi zone 2 mendekati zone 3, untuk mendapatkan jangkauan phase selection yang luas.</p>
			</text>
		</region>
		<region region-id="23322" left="42" top="6981" width="51" height="12.75" align-x="66" align-y="6990" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">Z2%</ml:id>
					<result xmlns="http://schemas.mathsoft.com/math30">
						<ml:real>120</ml:real>
					</result>
				</ml:eval>
			</math>
			<rendering item-idref="566"/>
		</region>
		<region region-id="23323" left="42" top="6993" width="82.5" height="18.75" align-x="66" align-y="7008" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">Z3%</ml:id>
					<result xmlns="http://schemas.mathsoft.com/math30">
						<ml:real>1348.61418847603</ml:real>
					</result>
				</ml:eval>
			</math>
			<rendering item-idref="567"/>
		</region>
		<region region-id="23324" left="42" top="7028.25" width="408" height="36" align-x="66" align-y="7038" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#80ffff" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Berdasarkan manual, X1Phs disetting lebih dari 1.44 XL11 agar menjangkau zone 2 namun hanya sampai mendekati zone 3. Phase selection digunakan untuk kebutuhan single pole autoreclose. Jadi atur nilai 1.44 (safety margin) agar dapat memenuhi persyaratan itu.</p>
			</text>
		</region>
		<region region-id="23325" left="42" top="7092" width="450" height="273.75" align-x="42" align-y="7092" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
