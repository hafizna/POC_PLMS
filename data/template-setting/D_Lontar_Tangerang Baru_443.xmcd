		<region region-id="45933" left="42" top="5420.25" width="423.75" height="24" align-x="42" align-y="5430" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f family="Arial" charset="0">
						<b>
							<inlineAttr line-through="false">Tipikal Resistive reach min (ph fault) : </inlineAttr>
						</b>
					</f>
					<f family="Arial" charset="0">
						<inlineAttr font-weight="normal" line-through="false">lebih besar dari fault resistance (dgn formula warrington)</inlineAttr>
					</f>
