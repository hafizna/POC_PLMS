		<region region-id="4994" left="54" top="8834.25" width="284.25" height="96" align-x="54" align-y="8844" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Parameter<tab/>
					<tab/>
					<tab/>
					<tab/>: POTT</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit"> Schme Function<tab/>
					<tab/>
					<tab/>: Enable</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit"> Rx Pickup Delay<tab/>
					<tab/>
					<tab/>: 0.000 sec</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit"> Seal in Delay<tab/>
					<tab/>
					<tab/>
					<tab/>: 0.024 sec</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit"> No Of Comm Bit<tab/>
					<tab/>
					<tab/>:<sp count="2"/>1</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit"> Rx 1<tab/>
					<tab/>
					<tab/>
					<tab/>
					<tab/>: Rec Dist On (W1a)</p>
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit"> Scheme Target<tab/>
