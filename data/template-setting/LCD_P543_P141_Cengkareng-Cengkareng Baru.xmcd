			</text>
		</region>
		<region region-id="59048" left="42" top="9758.25" width="84.75" height="12" align-x="50.25" align-y="9768" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">2.4.2 Address : 1-B</p>
			</text>
		</region>
		<region region-id="59049" left="42" top="9776.25" width="133.5" height="12" align-x="50.25" align-y="9786" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">2.4.3 Comms mode : Standard</p>
			</text>
		</region>
		<region region-id="59050" left="42" top="9800.25" width="141.75" height="12" align-x="50.25" align-y="9810" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">2.4.4 Baud rate Ch 1 : 64 kbits/s</p>
			</text>
		</region>
		<region region-id="59051" left="42" top="9824.25" width="142.5" height="12" align-x="50.25" align-y="9834" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">2.4.5 Clock source Ch1 : Internal</p>
			</text>
		</region>
		<region region-id="59052" left="42" top="9848.25" width="219" height="12" align-x="57.75" align-y="9858" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">2.4.6 Channel propagation delay tolerance (CDT)<sp count="2"/>:</p>
			</text>
		</region>
		<region region-id="59053" left="264" top="9848.25" width="18.75" height="12" align-x="271.5" align-y="9858" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
