			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<b>Setting of Fuse Failure supervision function based on U0-I0, U2-I2, and dU-dI (FSD)</b>
				</p>
			</text>
		</region>
		<region region-id="8889" left="60" top="8744.25" width="174" height="204" align-x="79.5" align-y="8754" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Operation <tab/>
					<tab/>= On</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">OpMode<tab/>
					<tab/>= UZsIZs</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Ubase<tab/>
					<tab/>
					<tab/>= 150kV</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Ibase<tab/>
					<tab/>
					<tab/>= 3000A</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">3U0&gt;<tab/>
					<tab/>
					<tab/>= 20% * Ubase</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">3I0&lt;<tab/>
					<tab/>
					<tab/>= 10% * Ibase</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">3U2&gt;<tab/>
					<tab/>
					<tab/>= 20% * Ubase</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">3I2&lt;<tab/>
					<tab/>
					<tab/>= 10% * Ibase</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Operation DUDI<tab/>
					<tab/>= On</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">DU&gt;<tab/>
					<tab/>
					<tab/>= 20% * Ubase</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">IPH&gt;<tab/>
					<tab/>
					<tab/>= 10% * Ibase</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">UPH&gt;<tab/>
					<tab/>
					<tab/>= 70% * Ubase</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">DI&lt;<tab/>
					<tab/>
					<tab/>= 10% * Ibase</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">SEALIN<tab/>
					<tab/>
					<tab/>= On</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">USealln&lt;<tab/>
					<tab/>= 60% * Ubase</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">UDLD&lt;<tab/>
					<tab/>
					<tab/>= 60% * Ubase</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">IDLD&lt;<tab/>
					<tab/>
					<tab/>= 20% * Ibase</p>
			</text>
		</region>
