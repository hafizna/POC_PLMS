			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Jangkauan Resistive Tidak Melebihi 0.5 Beban, tetapi beban tidak mungkin mencapai maksimum</p>
			</text>
		</region>
		<region region-id="10505" left="30" top="2984.25" width="109.5" height="29.25" align-x="73.5" align-y="3000" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">Resistive</ml:id>
					<ml:apply>
						<ml:mult/>
						<ml:apply>
							<ml:mult/>
							<ml:real>0.5</ml:real>
							<ml:id xml:space="preserve">n1</ml:id>
						</ml:apply>
						<ml:apply>
							<ml:div/>
							<ml:id xml:space="preserve">kV</ml:id>
							<ml:apply>
								<ml:mult/>
								<ml:id xml:space="preserve">ccc</ml:id>
								<ml:apply>
									<ml:sqrt/>
									<ml:real>3</ml:real>
								</ml:apply>
							</ml:apply>
						</ml:apply>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="232"/>
