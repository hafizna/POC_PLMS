		<region region-id="23512" left="30" top="9914.25" width="201" height="12" align-x="43.5" align-y="9924" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<b>Setting of Breaker Failure Function (BFP1)</b>
				</p>
			</text>
		</region>
		<region region-id="23513" left="258" top="9915" width="48.75" height="12.75" align-x="281.25" align-y="9924" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#ff0" tag="">
			<math optimize="false" disable-calc="false">
				<ml:id xml:space="preserve" xmlns:ml="http://schemas.mathsoft.com/math30">DISABLED</ml:id>
			</math>
			<rendering item-idref="698"/>
		</region>
		<region region-id="23514" left="60" top="9938.25" width="205.5" height="168" align-x="79.5" align-y="9948" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Operation<tab/>
					<tab/>
					<tab/>= On</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">RetripMode<tab/>
					<tab/>
					<tab/>= I&gt; Check</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">BUTripMode<tab/>
					<tab/>
					<tab/>= 1 out of 3</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">FunctionMode<tab/>
					<tab/>
					<tab/>= Current</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Ibase<tab/>
					<tab/>
					<tab/>
					<tab/>= 1600A</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">IP&gt;<tab/>
					<tab/>
					<tab/>
					<tab/>= 20% * Ibase</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">IN&gt;<tab/>
					<tab/>
					<tab/>
					<tab/>= 20% * Ibase</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">t1<tab/>
					<tab/>
					<tab/>
					<tab/>= 0.15s</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">t2<tab/>
					<tab/>
					<tab/>
					<tab/>= 0.25s</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">t2MPh<tab/>
					<tab/>
					<tab/>
					<tab/>= 0.25s</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">t3<tab/>
					<tab/>
					<tab/>
					<tab/>= 0.03s</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">tPulse<tab/>
					<tab/>
					<tab/>
					<tab/>= 0.20s</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">I&gt;BlkCont<tab/>
					<tab/>
					<tab/>= 20%* Ibase</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">tCBAlarm<tab/>
					<tab/>
					<tab/>= 5.00s</p>
			</text>
		</region>
		<region region-id="23515" left="0" top="10116" width="6000" height="6" align-x="0" align-y="10116" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<pageBreak/>
		</region>
		<region region-id="23516" left="48" top="10124.25" width="332.25" height="12" align-x="61.5" align-y="10134" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<b>Setting of single and/or three phase auto recloser device (AR1)</b>
				</p>
			</text>
		</region>
		<region region-id="23517" left="54" top="10142.25" width="360.75" height="12" align-x="56.25" align-y="10152" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">!Note: Operasi AR1: Externalctrl: Activation/deactivation is made by external switch</p>
			</text>
		</region>
		<region region-id="23518" left="18" top="10160.25" width="473.25" height="480" align-x="34.5" align-y="10170" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#80ff80" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<tab/>
					<tab/>
					<tab/>
					<tab/>
					<tab/>
					<tab/>
					<tab/>Operation <tab/>= ExternalCtrl<br/>Setting of the number of Auto reclose shots<tab/>
					<tab/>NoOfShots<tab/>= 1</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Setting of the Autoreclose first shot types allowed<tab/>
					<tab/>FirstShot<tab/>= SPAR</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Set if you want the AR to be started from CB Open instead</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">of from start inputs<tab/>
					<tab/>
					<tab/>
					<tab/>
					<tab/>StartByCBOpen<tab/>= Off</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Select the type of contact used for the CB position input<tab/>CBAuxContType= NO</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Extended t1S and t1 at PLC failure activated of not<tab/>Extended t1<tab/>= On</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Set the 3Ph shot 1 timer extention when the PLC is not</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">operative and connected to input PLCFAIL<tab/>
					<tab/>tExtended t1<tab/>= 0.5s</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Shot 1, Single phase reclosure dead-time<tab/>
					<tab/>
					<tab/>t1 1Ph<tab/>
					<tab/>= 1 s (SPAR)</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Shot 1, two phase reclosure dead time<tab/>
					<tab/>
					<tab/>t1 2Ph<tab/>
					<tab/>= 1 s (not used because of SPAR)</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Shot 1, Three phase reclosure dead time<tab/>
					<tab/>
					<tab/>t1 3Ph<tab/>
					<tab/>= 3 s (not used because of SPAR)</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Shot 1, Three phase reclosure dead time for high speed</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">shot without Synchrocheck<tab/>
					<tab/>
					<tab/>
					<tab/>t1 3PhHS<tab/>= 0.40s</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Shot 2, Three phase reclosure dead time<tab/>
					<tab/>
					<tab/>t2 3Ph<tab/>
					<tab/>= 60.00s</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Shot 3, Three phase reclosure dead time<tab/>
					<tab/>
					<tab/>t3 3Ph<tab/>
					<tab/>= 60.00s</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Shot 4, Three phase reclosure dead time<tab/>
					<tab/>
					<tab/>t4 3Ph<tab/>
					<tab/>= 60.00s</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Shot 5, Three phase reclosure dead time<tab/>
					<tab/>
					<tab/>t5 3Ph<tab/>
					<tab/>= 60.00s</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Select if you want the multi shot cycle to advance to next</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">shot at a new fault if CB has been closed <tab/>
					<tab/>Follow CB<tab/>= Off</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Maximum time for Synchro check condition to be fulfilled<tab/>tSync<tab/>
					<tab/>= 3.00s</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Reclose pulse duration<tab/>
					<tab/>
					<tab/>
					<tab/>
					<tab/>tPulse<tab/>
					<tab/>= 0.2s</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Setting of the operating mode<tab/>
					<tab/>
					<tab/>
					<tab/>CutPulse<tab/>= Off</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Set the reclaim time<tab/>
					<tab/>
					<tab/>
					<tab/>
					<tab/>tReclaim<tab/>= 40.00s </p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Set the inhibit reset time<tab/>
					<tab/>
					<tab/>
					<tab/>
					<tab/>tInhibit<tab/>
					<tab/>= 5.00s</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Setting of the type of CB Ready condition<tab/>
					<tab/>
					<tab/>CBReadyType<tab/>= OCO</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Max duration of trip or start signal<tab/>
					<tab/>
					<tab/>tTrip<tab/>
					<tab/>= 0.2s</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Setting of the Priority between AR terminals in multi </p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">breaker schemes<tab/>
					<tab/>
					<tab/>
					<tab/>
					<tab/>Priority<tab/>
					<tab/>= None</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Setting of the maximum wait time for Master to be ready<tab/>tWaitMaster<tab/>= 15.00s</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Setting of the time CB shall be closed before a fault</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">to get an AR attempt<tab/>
					<tab/>
					<tab/>
					<tab/>
					<tab/>tCBClosedMin<tab/>= 5.00s</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit"/>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Setting of the operating mode for next AR attempt<tab/>
					<tab/>AutoCont<tab/>
					<tab/>= Off</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Blocking of the Auto reclose program at unsuccessful </p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">auto reclosing<tab/>
					<tab/>
					<tab/>
					<tab/>
					<tab/>
					<tab/>BlockByUnsucCl<tab/>= Off</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Wait time after reclose attempt before proceeding to </p>
				<p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">next shots<tab/>
					<tab/>
					<tab/>
					<tab/>
					<tab/>
					<tab/>tAutoCondWait<tab/>
					<tab/>= 4.00s</p>
				<p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Setting of the signal mode at Unsuccessful reclosing<tab/>UnsucCIBYCBChk<tab/>= No CB Check</p>
				<p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">CB check time before unsuccessful alarm<tab/>
					<tab/>tUnsucCl<tab/>
					<tab/>= 20.00s</p>
			</text>
		</region>
		<region region-id="23519" left="198" top="10838.25" width="95.25" height="24" align-x="211.5" align-y="10848" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
