		<region region-id="13850" left="366" top="10989" width="70.5" height="18.75" align-x="393.75" align-y="11004" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:provenance expr-id="1">
						<originRef doc-id="69A5344B-8476-4167-8115-666AECD77FA6" version-id="E9E92627-6F73-4E7B-BB58-01A6BA3946A1" branch-id="00000000-0000-0000-0000-000000000000" revision-num="501623964" is-modified="true" region-id="0" href="G:\1_KANTOR\01_BINPRO\00_SETTING RELAY\03. Ex. RJTD\RJTD\Mathcad\@P H T\PHT - KUDUS\KUDUS\Bay Jekulo\REL670  Kudus-Jekulo 1&amp;2_final.xmcd" xmlns="http://schemas.mathsoft.com/provenance10">
